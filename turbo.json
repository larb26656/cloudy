{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "copy-assets": {
      "dependsOn": ["web-app#build", "build"],
      "inputs": ["../web-app/dist/**", "../../packages/server/drizzle/**", "../../scripts/copy-assets.ts"],
      "outputs": ["dist/drizzle/**", "dist/public/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["SHELL", "PATH"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "inputs": ["src/schema/**", "drizzle.config.ts", "drizzle/**"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
