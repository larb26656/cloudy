{
  "name": "cloudy-extension",
  "description": "Cloudy browser extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build --mode production",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "xpi:firefox": "wxt zip -b firefox && cp .output/*-firefox.zip .output/cloudy-firefox.xpi",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/maitree": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@opencode-ai/sdk": "^1.18.13",
    "@repo/contracts": "workspace:*",
    "@repo/opencode": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/turndown": "^5.0.6",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turndown": "^7.2.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
