{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.preload.config.ts",
    "copy-assets": "tsx ../../scripts/copy-desktop-assets.ts",
    "dist": "electron-builder build --mac",
    "dev": "pnpm build && concurrently -k -s first -n tsup-main,tsup-preload,electron -c blue,cyan,magenta \"tsup --config tsup.config.ts --watch\" \"tsup --config tsup.preload.config.ts --watch\" \"electron .\"",
    "start": "electron .",
    "rebuild:native": "tsx scripts/rebuild-native.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "better-sqlite3": "12.11.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "node-gyp": "^12.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
