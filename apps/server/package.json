{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "cloudy": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "copy-assets": "tsx ../../scripts/copy-assets.ts",
    "dev": "tsx watch src/cli.ts serve --config=config --host=127.0.0.1 --port=5122 --cors http://localhost:3001",
    "dev:ui": "tsx watch src/cli.ts serve --config=config  --host=127.0.0.1 --port=5122 --cors http://localhost:3001 --ui --ui-dir ../../apps/web-app/dist",
    "start": "node dist/cli.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "better-sqlite3": "^11.8.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "commander": "^14.0.0",
    "eslint": "^9.39.1",
    "picocolors": "^1.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
