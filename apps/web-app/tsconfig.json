{
  "extends": "@repo/typescript-config/vite-react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    },
    "noUncheckedIndexedAccess": false,
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.stories.tsx",
    "src/**/*.stories.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/components/ui/calendar.tsx",
    "src/components/ui/carousel.tsx",
    "src/components/ui/chart.tsx",
    "src/components/ui/drawer.tsx",
    "src/components/ui/input-otp.tsx",

    "src/features/artifact/**",
    "src/features/dashboard/**",
    "src/features/idea/**",
    "src/features/memory/**",
    "src/features/onboarding/**",
    "src/features/settings/**",

    "src/routes/_appMainLayout/artifact.tsx",
    "src/routes/_appMainLayout/dashboard.tsx",
    "src/routes/_appMainLayout/ideas/**",
    "src/routes/_appMainLayout/memory.tsx",
    "src/routes/_onboardLayout/**",
    "src/routes/ideas.$id.tsx",
    "src/routes/settings.tsx",
    "src/routes/settings/**",
  ],
}
