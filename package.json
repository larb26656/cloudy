{
  "name": "cloudy",
  "version": "1.0.0",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.5.2",
    "biome": "^0.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "cd apps/server && npm run dev",
    "dev:web-app": "cd apps/web-app && npm run dev",
    "dev:web-app:electron": "cd apps/web-app && npm run dev:electron",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "dev": "concurrently -n \"server,web-app\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:web-app\"",
    "dev:app": "concurrently -n \"server,web-app,desktop\" -c \"blue,magenta,green\" \"npm run dev:server\" \"npm run dev:web-app:electron\" \"npm run dev:desktop\"",
    "----LINT----": "",
    "lint": "biome check",
    "lint:write": "biome check --write",
    "format": "biome format --write .",
    "---CHANGE-LOG----": "",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "---CREATE-CLOUDY---": "",
    "dev:create-cloudy": "rm -rf packages/create-cloudy/.test-output && node packages/create-cloudy/src/index.ts --dir=packages/create-cloudy/.test-output",
    "test:create-cloudy": "node packages/create-cloudy/dist/index.js --dir=packages/create-cloudy/.test-output",
    "----CLOUDY-CLI----": "",
    "cloudy:build": "node scripts/build-cloudy.js",
    "----CLOUDY-DESKTOP---": "",
    "build:desktop:frontend": "node scripts/build-desktop-frontend.js",
    "start:desktop": "npm run build:desktop:frontend && node scripts/start-desktop.js",
    "build:desktop": "node scripts/build-desktop.js",
    "----CI----": "",
    "publish:opencode-plugin": "npm publish --workspace=packages/opencode-plugin",
    "publish:create-cloudy": "npm publish --workspace=packages/create-cloudy",
    "----CLEAN----": ""
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}
