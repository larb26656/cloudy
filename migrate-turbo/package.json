{
  "name": "migrate-cloudy",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate:package": "npx tsx scripts/generate-package.ts",
    "dev:web-app": "turbo run dev --filter=web-app",
    "build:web-app": "turbo run build --filter=web-app",
    "check-types:web-app": "turbo run check-types --filter=web-app"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "tsx": "^4.23.0"
  }
}
